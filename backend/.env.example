# ==============================================================================
# BREACHGUARD ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and populate with production values.
# NEVER commit production .env to source control.
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development

# Master Cryptographic Secret Key (minimum 32 characters / 256 bits)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_cryptographically_secure_256_bit_random_secret

# Dedicated Outbound Webhook Signing Key (isolated from master SECRET_KEY)
WEBHOOK_SIGNING_KEY=replace_with_cryptographically_secure_random_webhook_key

# Asynchronous Database Connection URL
# PostgreSQL (Production): postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# SQLite (Local Dev): sqlite+aiosqlite:///./darkweb.db
DATABASE_URL=sqlite+aiosqlite:///./darkweb.db

# Scheduled Scans Serverless Cron Secret (required for /api/cron/scans)
CRON_SECRET=replace_with_strong_random_cron_secret

# Stripe Billing Webhook Secret (whsec_...)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Distributed Cache & Rate Limiting (Redis / Upstash)
REDIS_URL=redis://localhost:6379/0

# Threat Intelligence & Exposure Providers (Optional / Tiered)
HIBP_API_KEY=
LEAKCHECK_API_KEY=
VIRUSTOTAL_API_KEY=

# Outbound Email Dispatcher (Resend or SMTP)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=security@breachguard.io

# Frontend Application Origin URL
FRONTEND_URL=http://localhost:3000

# Trusted Reverse Proxy CIDRs / IPs (comma-separated, optional)
TRUSTED_PROXIES=
